      pcMessage: 
      mobileMessage: 
    itemPopupMenu: {fileID: 1614949507}
    itemPopupImage: {fileID: 1486701458}
    itemPopupText: {fileID: 430183153}
    itemPopups:
    - name: Lace
      isTimeBased: 1
      duration: 4
      isPlataformSpecific: 0
      defaultMessage: "\"Feita \xE0 m\xE3o com fios de algod\xE3o e com n\xF3s de
        lac\xEAs\"\r\n<color=\"white\">Leve a renda para Dona Luzia completar a encomenda
        da Martha.</color>"
      pcMessage: 
      mobileMessage: 
      icon: {fileID: 832520698, guid: 9bc07c7e9715edb4dacb84158883d872, type: 3}
    - name: CottonCord
      isTimeBased: 1
      duration: 4
      isPlataformSpecific: 0
      defaultMessage: "\"A arte das rendeiras alagoanas. De redes de pescas \xE0
        bordados vibrantes.\"\r\n<color=\"white\">Colete os 3 cord\xF5es para completar
        a renda Fil\xE9.</color>"
      pcMessage: 
      mobileMessage: 
      icon: {fileID: 1211438655, guid: 9ff35f735aa202a44ac61dabcaf7ff6c, type: 3}
    - name: Needle
      isTimeBased: 1
      duration: 4
      isPlataformSpecific: 0
      defaultMessage: "\"Cada agulha, feita a m\xE3o com precis\xE3o, usado na tecelagem
        do bordado fil\xE9.\"\r\n<color=\"white\">Colete os cord\xF5es para tecer
        com a agulha a renda fil\xE9.</color>"
      pcMessage: 
      mobileMessage: 
      icon: {fileID: 2094486431, guid: eeda9bfd8562cab4681430bbe18b4707, type: 3}
