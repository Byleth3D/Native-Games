  m_Script: {fileID: 11500000, guid: 280529e79cafc8a41af05e22e94ab9d5, type: 3}
  m_Name: Subtitle - Cavalo
  m_EditorClassIdentifier: 
  lines:
  - startTimeInMinutes: 00:00
    endTimeInMinutes: 00:08
    text: "Aaah\u2026 O bom e velho cavalo de madeira, o brinquedo com o qual todas
      as crian\xE7as se divertiam fazendo e brincando."
  - startTimeInMinutes: 00:09
    endTimeInMinutes: 00:12
    text: "Dura mais que pl\xE1stico e \xE9 a cara da inf\xE2ncia."
